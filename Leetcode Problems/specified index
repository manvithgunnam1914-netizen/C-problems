import java.util.Scanner;
public class main {
    public static void main (String[] args) {
        Scanner scan = new Scanner(System.in);
        int n = scan.nextInt();
        long[] nums = new long[n];
        for (int i = 0; i < n; i++) {
            nums[i] = scan.nextLong();
        }
        int ind = scan.nextInt();
        System.out.println(nums[ind]);
    }
}
