class Solution {
    int maxSubarraySum(int[] nums) {
        // Code here
        int globalMax=nums[0];
        int runningSum=nums[0];
        for(int i=1;i<nums.length;i++){
            if(runningSum+nums[i]<nums[i])
               runningSum=nums[i];
               else
               runningSum+=nums[i];
               if(runningSum<0)
               runningSum=nums[i];
               if(runningSum>globalMax)
               globalMax=runningSum;
        }
        return globalMax;
    }
}
