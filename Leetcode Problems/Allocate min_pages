class Solution {
    public int check(int[] nums, int k, long mid) {
        int student = 1;
        long sum = 0;
        for (int i = 0; i < nums.length; i++) {
            if (sum + nums[i] <= mid) {
                sum += nums[i];
            } else {
                student++;
                sum = nums[i];
            }
        }
       if (student <= k) {
           return 1;
       } else {
           return 0;
       }
    }
    public int findPages(int[] nums, int k) {
        if (k > nums.length)
            return -1;
        long st = 0, end = 0;
        for (int i = 0; i < nums.length; i++) {
            st = Math.max(st, nums[i]);
            end += nums[i];
        }
        long ans = end;
        while (st <= end) {
            long mid = (st + end) / 2;
            int res = check(nums, k, mid);
            if (res == 1) {
                ans = mid;
                end = mid - 1;
            } else {
                st = mid + 1;
            }
        }
        return (int)ans;
    }
}
