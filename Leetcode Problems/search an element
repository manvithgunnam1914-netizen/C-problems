import java.util.Scanner;
public class main{
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        int n = scan.nextInt();
        long[] nums = new long[n];
        for (int i = 0; i < n; i++) {
            nums[i] = scan.nextLong();
        }
        long target = scan.nextLong();
        int index = -1;
        for (int i = 0; i < n; i++) {
            if (nums[i] == target) {
                index = i;
                break;
            }
        }
        System.out.println(index);
    }
}
