import java.util.Scanner;
public class main {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        int n = scan.nextInt();
        long[] nums = new long[n];
        for (int i = 0; i < n; i++) {
            nums[i] = scan.nextLong();
        }
        for (int i = 1; i < n; i++) {
            if (nums[i] == nums[i - 1]) {
                if (i == 1 || nums[i] != nums[i - 2]) {
                    System.out.print(nums[i] + " ");
                }
            }
        }
    }
}
