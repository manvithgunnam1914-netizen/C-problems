import java.util.Arrays;
class Solution {
    public void moveZeroes(int[] nums) {
        reOrder(nums, 0, 0);
    }
    private static void reOrder(int[] arr, int index, int proper) {
        if (index == arr.length) {
            Arrays.fill(arr, proper, arr.length, 0);
            return;
        }
        if (arr[index] != 0) {
            arr[proper] = arr[index];
            proper++;
        }
        reOrder(arr, index + 1, proper);
    }
    public static void main(String[] args) {
        int[] issues = {0, 1, 0, 3, 12};
        new Solution().moveZeroes(issues);
    }
}
