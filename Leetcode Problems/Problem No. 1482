class Solution {
    public int check(int[] arr, int m, int k, int days) {
        int cons_flowers = 0, boq = 0;
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] <= days)
                cons_flowers++;
            else 
                cons_flowers = 0;
            if (cons_flowers == k) {
                boq++;
                cons_flowers = 0;
            }
        }
        if (boq >= m)
            return 1;
        else return 0;
    }
    public int minDays(int[] arr, int m, int k) {
        int min = arr[0], max = arr[0];
        int n = arr.length;
        if (n < (long) m * k)
            return -1;
        for (int i = 1; i < n; i++) {
            if (arr[i] < min)
                min = arr[i];
            if (arr[i] > max)
                max = arr[i];
        }
        int ans = max;
        while(min < max) {
            int mid = (min + max) / 2;
            int res = check (arr, m, k, mid);
            if (res == 1) {
                max = mid;
                if (mid < ans)
                    ans = mid;
            }
            else {
                min = mid + 1;
            }
        }
        return ans;
    }
}
